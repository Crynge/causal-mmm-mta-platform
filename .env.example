# Environment Configuration for Causal MMM + MTA Platform

# OpenAI API (for automated insights and report generation)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4-turbo-preview

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/mmm_mta_db
DELTA_LAKE_PATH=./data/delta_lake

# Feature Store
FEAST_REDIS_HOST=localhost
FEAST_REDIS_PORT=6379
FEAST_REGISTRY_PATH=./feature_store/registry

# Ad Platform API Keys
GOOGLE_ADS_DEVELOPER_TOKEN=your_google_ads_token
GOOGLE_ADS_CLIENT_ID=your_google_client_id
GOOGLE_ADS_CLIENT_SECRET=your_google_client_secret
GOOGLE_ADS_REFRESH_TOKEN=your_google_refresh_token

FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_ACCESS_TOKEN=your_facebook_access_token

TIKTOK_ACCESS_TOKEN=your_tiktok_token
TWITTER_CONSUMER_KEY=your_twitter_consumer_key
TWITTER_CONSUMER_SECRET=your_twitter_consumer_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret

SALESFORCE_CLIENT_ID=your_salesforce_client_id
SALESFORCE_CLIENT_SECRET=your_salesforce_client_secret
SALESFORCE_USERNAME=your_salesforce_username
SALESFORCE_PASSWORD=your_salesforce_password
SALESFORCE_SECURITY_TOKEN=your_salesforce_security_token

# Bayesian Sampling Configuration
NUM_CHAINS=4
NUM_SAMPLES=2000
NUM_WARMUP=1000
TARGET_ACCEPT_RATE=0.8
MAX_TREE_DEPTH=10

# Causal Discovery Configuration
PC_ALPHA=0.05
FCI_MAX_CONDITIONING_SET=3
DOMAIN_KNOWLEDGE_CONSTRAINTS=./config/domain_constraints.json

# Optimization Constraints
MIN_BUDGET_PER_CHANNEL=1000
MAX_BUDGET_PER_CHANNEL=10000000
ROAS_FLOOR=2.0
CPA_TARGET=50.0
BUDGET_SMOOTHNESS_FACTOR=0.1

# Data Quality SLAs
MAX_DATA_LATENCY_HOURS=24
MIN_DATA_COMPLETENESS_PCT=95.0
DUPLICATE_TOLERANCE_PCT=0.1

# Monitoring & Alerting
SENTRY_DSN=your_sentry_dsn
PROMETHEUS_PORT=9090
LOG_LEVEL=INFO

# Ray Cluster Configuration
RAY_HEAD_NODE_HOST=localhost
RAY_NUM_CPUS=16
RAY_NUM_GPUS=2
RAY_OBJECT_STORE_MEMORY=10GB

# Airflow Configuration
AIRFLOW_HOME=./airflow
AIRFLOW_EXECUTOR=LocalExecutor
AIRFLOW_LOAD_EXAMPLES=False
